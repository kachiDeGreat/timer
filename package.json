{
  "name": "stagetimer-pro",
  "private": true,
  "version": "1.0.1",
  "description": "Professional Stage & Studio Countdown Timer with Automated External Projector Output",
  "author": "StageTimer Pro Team <contact@stagetimer.pro>",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "electron electron/main.cjs --no-sandbox",
    "electron:dev": "concurrently -k \"vite\" \"electron electron/main.cjs --no-sandbox\"",
    "build:linux": "npm run build && electron-builder --linux AppImage deb",
    "build:win": "npm run build && electron-builder --win nsis portable",
    "build:mac": "npm run build && electron-builder --mac dmg zip",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.stagetimer.pro",
    "productName": "StageTimer Pro",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Utility"
    },
    "deb": {
      "maintainer": "StageTimer Pro Team <contact@stagetimer.pro>",
      "synopsis": "Professional Stage & Studio Countdown Timer"
    },

    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "background": null,
      "backgroundColor": "#121212"
    }
  }
}

